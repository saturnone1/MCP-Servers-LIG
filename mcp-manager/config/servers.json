{
  "servers": [
    {
      "name": "mcp-office",
      "kind": "docker",
      "port": 42180,
      "image": "local/mcp-office",
      "groups": [
        "docker",
        "office"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace"
      }
    },
    {
      "name": "mcp-filesystem",
      "kind": "docker",
      "port": 42181,
      "image": "local/mcp-filesystem",
      "groups": [
        "docker",
        "files"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace"
      }
    },
    {
      "name": "mcp-git",
      "kind": "docker",
      "port": 42182,
      "image": "local/mcp-git",
      "groups": [
        "docker",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace"
      }
    },
    {
      "name": "mcp-shell",
      "kind": "docker",
      "port": 42183,
      "image": "local/mcp-shell",
      "groups": [
        "docker",
        "shell"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace"
      }
    },
    {
      "name": "mcp-dotnet",
      "kind": "docker",
      "port": 42184,
      "image": "local/mcp-dotnet",
      "groups": [
        "docker",
        "dev"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace"
      }
    },
    {
      "name": "mcp-mssql",
      "kind": "docker",
      "port": 42185,
      "image": "local/mcp-mssql",
      "groups": [
        "docker",
        "database"
      ],
      "volumes": [
        "{repo}:/workspace",
        "C:\\:/host/c"
      ],
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace;C:\\=/host/c"
      }
    },
    {
      "name": "mcp-hwp",
      "kind": "docker",
      "port": 42186,
      "image": "local/mcp-hwp",
      "groups": [
        "docker",
        "office"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace"
      }
    },
    {
      "name": "mcp-kubernetes",
      "kind": "docker",
      "port": 42187,
      "image": "local/mcp-kubernetes",
      "groups": [
        "docker",
        "kubernetes",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace",
        "{home}\\.kube:/root/.kube"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace"
      }
    },
    {
      "name": "mcp-docker",
      "kind": "docker",
      "port": 42188,
      "image": "local/mcp-docker",
      "groups": [
        "docker",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace",
        "/var/run/docker.sock:/var/run/docker.sock"
      ],
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace"
      }
    },
    {
      "name": "mcp-prometheus",
      "kind": "docker",
      "port": 42189,
      "image": "local/mcp-prometheus",
      "groups": [
        "docker",
        "observability"
      ],
      "volumes": [
        "{repo}:/workspace"
      ]
    },
    {
      "name": "mcp-postgresql",
      "kind": "docker",
      "port": 42190,
      "image": "local/mcp-postgresql",
      "groups": [
        "docker",
        "database"
      ],
      "volumes": [
        "{repo}:/workspace"
      ]
    },
    {
      "name": "mcp-gitlab",
      "kind": "docker",
      "port": 42191,
      "image": "local/mcp-gitlab",
      "groups": [
        "docker",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace"
      ]
    },
    {
      "name": "mcp-jira",
      "kind": "docker",
      "port": 42192,
      "image": "local/mcp-jira",
      "groups": [
        "docker",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace"
      ]
    },
    {
      "name": "mcp-loki",
      "kind": "docker",
      "port": 42193,
      "image": "local/mcp-loki",
      "groups": [
        "docker",
        "observability"
      ],
      "volumes": [
        "{repo}:/workspace"
      ]
    },
    {
      "name": "mcp-confluence",
      "kind": "docker",
      "port": 42198,
      "image": "local/mcp-confluence",
      "groups": [
        "docker",
        "devops",
        "knowledge"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "env": {
        "CONFLUENCE_BASE_URL": "http://localhost",
        "CONFLUENCE_BEARER_TOKEN": "",
        "CONFLUENCE_PAT": "",
        "CONFLUENCE_USERNAME": "",
        "CONFLUENCE_API_TOKEN": "",
        "CONFLUENCE_COOKIE": "",
        "MCP_ENABLE_CONFLUENCE_WRITES": "true"
      }
    },
    {
      "name": "mcp-rhapsody",
      "kind": "process",
      "port": 42194,
      "groups": [
        "windows",
        "desktop",
        "modeling"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-rhapsody-win-x64",
      "executable": "McpRhapsody.exe"
    },
    {
      "name": "mcp-matlab",
      "kind": "process",
      "port": 42195,
      "groups": [
        "windows",
        "desktop",
        "engineering"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-matlab-win-x64",
      "executable": "McpMatlab.exe"
    },
    {
      "name": "mcp-autocad",
      "kind": "process",
      "port": 42196,
      "groups": [
        "windows",
        "desktop",
        "cad"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-autocad-win-x64",
      "executable": "McpAutoCad.exe"
    },
    {
      "name": "mcp-solidworks",
      "kind": "process",
      "port": 42197,
      "groups": [
        "windows",
        "desktop",
        "cad"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-solidworks-win-x64",
      "executable": "McpSolidWorks.exe"
    },
    {
      "name": "mcp-pdf",
      "kind": "process",
      "port": 42199,
      "groups": [
        "windows",
        "document",
        "knowledge"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-pdf-win-x64",
      "executable": "McpPdf.exe",
      "env": {
        "MCP_ALLOWED_DIRS": "*",
        "MCP_ENABLE_PDF_WRITES": "true",
        "DOCLING_MODE": "remote",
        "DOCLING_SERVICE_URL": "http://127.0.0.1:5001",
        "DOCLING_USE_ASYNC": "true",
        "PDF_EMBEDDING_PROVIDER": "none"
      }
    }
  ]
}
