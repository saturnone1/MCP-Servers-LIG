{
  "servers": [
    {
      "name": "mcp-office",
      "kind": "docker",
      "port": 42180,
      "image": "local/mcp-office",
      "groups": [
        "docker",
        "office"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace",
        "MCP_ALLOWED_DIRS": "/",
        "MCP_ENABLE_OFFICE_WRITES": "true",
        "OFFICECLI_PATH": "officecli",
        "ANTIWORD_PATH": "antiword"
      }
    },
    {
      "name": "mcp-filesystem",
      "kind": "docker",
      "port": 42181,
      "image": "local/mcp-filesystem",
      "groups": [
        "docker",
        "files"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace",
        "MCP_ALLOWED_DIRS": "/",
        "MCP_ENABLE_WRITES": "true"
      }
    },
    {
      "name": "mcp-git",
      "kind": "docker",
      "port": 42182,
      "image": "local/mcp-git",
      "groups": [
        "docker",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace",
        "MCP_ALLOWED_DIRS": "/",
        "MCP_ENABLE_GIT_WRITES": "true"
      }
    },
    {
      "name": "mcp-shell",
      "kind": "docker",
      "port": 42183,
      "image": "local/mcp-shell",
      "groups": [
        "docker",
        "shell"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace",
        "MCP_ALLOWED_DIRS": "/",
        "MCP_ENABLE_SHELL": "true",
        "MCP_SHELL_ALLOWED_COMMANDS": "",
        "MCP_SHELL_ALLOWED_ENV": ""
      }
    },
    {
      "name": "mcp-dotnet",
      "kind": "docker",
      "port": 42184,
      "image": "local/mcp-dotnet",
      "groups": [
        "docker",
        "dev"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace",
        "MCP_ALLOWED_DIRS": "/",
        "MCP_ENABLE_DOTNET_WRITES": "true",
        "MCP_DOTNET_CLI_PATH": ""
      }
    },
    {
      "name": "mcp-mssql",
      "kind": "docker",
      "port": 42185,
      "image": "local/mcp-mssql",
      "groups": [
        "docker",
        "database"
      ],
      "volumes": [
        "{repo}:/workspace",
        "C:\\:/host/c"
      ],
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace;C:\\=/host/c",
        "MSSQL_CONNECTION_STRING": "",
        "MCP_ENABLE_SQL_WRITES": "true"
      }
    },
    {
      "name": "mcp-hwp",
      "kind": "docker",
      "port": 42186,
      "image": "local/mcp-hwp",
      "groups": [
        "docker",
        "office"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace",
        "MCP_ALLOWED_DIRS": "/",
        "SOFFICE_PATH": "soffice",
        "HWP5TXT_PATH": "hwp5txt",
        "MCP_ENABLE_HWP_WRITES": "true"
      }
    },
    {
      "name": "mcp-kubernetes",
      "kind": "docker",
      "port": 42187,
      "image": "local/mcp-kubernetes",
      "groups": [
        "docker",
        "kubernetes",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace",
        "{home}\\.kube:/root/.kube"
      ],
      "mountHostDrives": true,
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace",
        "MCP_ALLOWED_DIRS": "/",
        "MCP_ENABLE_KUBERNETES_WRITES": "true",
        "MCP_ENABLE_RAW_KUBECTL": "true",
        "KUBECTL_PATH": "kubectl"
      }
    },
    {
      "name": "mcp-docker",
      "kind": "docker",
      "port": 42188,
      "image": "local/mcp-docker",
      "groups": [
        "docker",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace",
        "/var/run/docker.sock:/var/run/docker.sock"
      ],
      "env": {
        "MCP_PATH_MAPPINGS": "{repo}=/workspace",
        "MCP_ENABLE_DOCKER_WRITES": "true",
        "DOCKER_PATH": "docker"
      }
    },
    {
      "name": "mcp-prometheus",
      "kind": "docker",
      "port": 42189,
      "image": "local/mcp-prometheus",
      "groups": [
        "docker",
        "observability"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "env": {
        "PROMETHEUS_BASE_URL": "http://host.docker.internal:9090",
        "PROMETHEUS_BEARER_TOKEN": ""
      }
    },
    {
      "name": "mcp-postgresql",
      "kind": "docker",
      "port": 42190,
      "image": "local/mcp-postgresql",
      "groups": [
        "docker",
        "database"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "env": {
        "POSTGRES_CONNECTION_STRING": "",
        "MCP_ENABLE_POSTGRES_WRITES": "true"
      }
    },
    {
      "name": "mcp-gitlab",
      "kind": "docker",
      "port": 42191,
      "image": "local/mcp-gitlab",
      "groups": [
        "docker",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "env": {
        "GITLAB_BASE_URL": "http://gitlab.local",
        "GITLAB_TOKEN": "",
        "MCP_ENABLE_GITLAB_WRITES": "true"
      }
    },
    {
      "name": "mcp-jira",
      "kind": "docker",
      "port": 42192,
      "image": "local/mcp-jira",
      "groups": [
        "docker",
        "devops"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "env": {
        "JIRA_BASE_URL": "http://jira.local",
        "JIRA_BEARER_TOKEN": "",
        "JIRA_EMAIL": "",
        "JIRA_API_TOKEN": "",
        "MCP_ENABLE_JIRA_WRITES": "true"
      }
    },
    {
      "name": "mcp-loki",
      "kind": "docker",
      "port": 42193,
      "image": "local/mcp-loki",
      "groups": [
        "docker",
        "observability"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "env": {
        "LOKI_BASE_URL": "http://host.docker.internal:3100",
        "LOKI_BEARER_TOKEN": "",
        "LOKI_USERNAME": "",
        "LOKI_PASSWORD": "",
        "LOKI_TENANT_ID": ""
      }
    },
    {
      "name": "mcp-confluence",
      "kind": "docker",
      "port": 42198,
      "image": "local/mcp-confluence",
      "groups": [
        "docker",
        "devops",
        "knowledge"
      ],
      "volumes": [
        "{repo}:/workspace"
      ],
      "env": {
        "CONFLUENCE_BASE_URL": "http://localhost",
        "CONFLUENCE_BEARER_TOKEN": "",
        "CONFLUENCE_PAT": "",
        "CONFLUENCE_USERNAME": "",
        "CONFLUENCE_API_TOKEN": "",
        "CONFLUENCE_PASSWORD": "",
        "CONFLUENCE_COOKIE": "",
        "MCP_ENABLE_CONFLUENCE_WRITES": "true"
      }
    },
    {
      "name": "mcp-rhapsody",
      "kind": "process",
      "port": 42194,
      "groups": [
        "windows",
        "desktop",
        "modeling"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-rhapsody-win-x64",
      "executable": "McpRhapsody.exe",
      "env": {
        "RHAPSODY_INSTALL_DIR": "",
        "RHAPSODY_EXE_PATH": "",
        "RHAPSODY_CLI_PATH": "",
        "RHAPSODY_COM_PROGID": "",
        "MCP_ALLOWED_DIRS": "*",
        "MCP_ENABLE_RHAPSODY_WRITES": "true",
        "MCP_ENABLE_RHAPSODY_CLI": "true"
      }
    },
    {
      "name": "mcp-matlab",
      "kind": "process",
      "port": 42195,
      "groups": [
        "windows",
        "desktop",
        "engineering"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-matlab-win-x64",
      "executable": "McpMatlab.exe",
      "env": {
        "MATLAB_ROOT": "",
        "MATLAB_EXE_PATH": "",
        "MATLAB_COM_PROGID": "Matlab.Application",
        "MATLAB_MCP_CORE_SERVER_PATH": "{repo}\\windows-host-publish\\mcp-matlab-win-x64\\official\\matlab-mcp-core-server-win64.exe",
        "MATLAB_MCP_CORE_SERVER_ARGS": "",
        "POWERSHELL_EXE_PATH": "powershell",
        "MCP_ALLOWED_DIRS": "*",
        "MCP_ENABLE_MATLAB_WRITES": "true"
      }
    },
    {
      "name": "mcp-autocad",
      "kind": "process",
      "port": 42196,
      "groups": [
        "windows",
        "desktop",
        "cad"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-autocad-win-x64",
      "executable": "McpAutoCad.exe",
      "env": {
        "AUTOCAD_EXE_PATH": "",
        "AUTOCAD_COM_PROGID": "AutoCAD.Application",
        "MCP_ALLOWED_DIRS": "*",
        "MCP_ENABLE_AUTOCAD_WRITES": "true"
      }
    },
    {
      "name": "mcp-solidworks",
      "kind": "process",
      "port": 42197,
      "groups": [
        "windows",
        "desktop",
        "cad"
      ],
      "workingDirectory": "{repo}\\windows-host-publish\\mcp-solidworks-win-x64",
      "executable": "McpSolidWorks.exe",
      "env": {
        "SOLIDWORKS_EXE_PATH": "",
        "SOLIDWORKS_COM_PROGID": "SldWorks.Application",
        "MCP_ALLOWED_DIRS": "*",
        "MCP_ENABLE_SOLIDWORKS_WRITES": "true"
      }
    }
  ]
}
