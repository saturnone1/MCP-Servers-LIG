<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="LIG AI MCP Server Suite"
    Manufacturer="LIG Defense &amp; Aerospace"
    Version="$(ProductVersion)"
    UpgradeCode="A77A4464-74E0-4B6C-94C4-D15FCBD744E5"
    Scope="perMachine"
    InstallerVersion="500">

    <SummaryInformation Description="LIG AI MCP Server Suite" />
    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of LIG AI MCP Server Suite is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="LIG AI MCP">
        <Directory Id="DEPENDENCIESFOLDER" Name="dependencies">
          <Directory Id="POPPLERFOLDER" Name="poppler" />
        </Directory>
        <Component Id="CustomArpRegistration" Guid="3F7B4A2D-05C1-4DCF-9C8F-80AD30FB59F1">
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="DisplayName" Type="string" Value="LIG AI MCP Server Suite" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="DisplayVersion" Type="string" Value="[ProductVersion]" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="Publisher" Type="string" Value="LIG Defense &amp; Aerospace" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="DisplayIcon" Type="string" Value="[INSTALLFOLDER]McpManager.exe" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="UninstallString" Type="string" Value="&quot;[INSTALLFOLDER]LIG-AI-MCP-Uninstall.exe&quot;" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="QuietUninstallString" Type="string" Value="&quot;[INSTALLFOLDER]LIG-AI-MCP-Uninstall.exe&quot; --quiet" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="NoModify" Type="integer" Value="1" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\LIG-AI-MCP-Server-Suite" Name="NoRepair" Type="integer" Value="1" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="LIG AI MCP">
        <Component Id="ApplicationStartMenuShortcuts" Guid="*">
          <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="LIG AI MCP"
            Description="Open the LIG AI MCP server manager"
            Target="[INSTALLFOLDER]McpManager.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
          <Shortcut
            Id="UninstallStartMenuShortcut"
            Name="Uninstall LIG AI MCP"
            Target="[INSTALLFOLDER]LIG-AI-MCP-Uninstall.exe" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
              Root="HKLM"
            Key="Software\LIG Defense and Aerospace\LIG AI MCP"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="ApplicationDesktopShortcut" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="LIG AI MCP"
          Description="Open the LIG AI MCP server manager"
          Target="[INSTALLFOLDER]McpManager.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon" />
        <RegistryValue
              Root="HKLM"
          Key="Software\LIG Defense and Aerospace\LIG AI MCP"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Core" Title="LIG AI MCP Server Suite" Level="1">
      <Files Include="$(BundleDirectory)\**" Directory="INSTALLFOLDER">
        <Exclude Files="$(BundleDirectory)\autostart.json" />
        <Exclude Files="$(BundleDirectory)\dependencies\poppler\**" />
      </Files>
      <ComponentRef Id="ApplicationStartMenuShortcuts" />
      <ComponentRef Id="ApplicationDesktopShortcut" />
      <ComponentRef Id="CustomArpRegistration" />
    </Feature>
    <Feature Id="Poppler" Title="PDF page rendering tools (Poppler)" Description="Installs the optional pdftoppm renderer used by MCP-PDF." Level="1">
      <Files Include="$(PopplerDirectory)\**" Directory="POPPLERFOLDER" />
    </Feature>
  </Package>
</Wix>
