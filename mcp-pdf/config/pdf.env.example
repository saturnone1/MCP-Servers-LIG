MCP_ALLOWED_DIRS=*
MCP_ENABLE_PDF_WRITES=true
PDF_DATA_DIR=%LOCALAPPDATA%\LIG AI MCP\pdf
PDF_JOB_DB=%LOCALAPPDATA%\LIG AI MCP\pdf\mcp-pdf.db
PDF_MAX_CONCURRENT_JOBS=2
PDF_JOB_TIMEOUT_SECONDS=86400
PDF_DEFAULT_PROFILE=balanced-ko
PDF_DEFAULT_CHUNK_PROFILE=rag-default
DOCLING_MODE=remote
DOCLING_SERVICE_URL=http://127.0.0.1:5001
DOCLING_SERVICE_API_KEY=
DOCLING_COMMAND=docling
DOCLING_USE_ASYNC=true
DOCLING_POLL_INTERVAL_SECONDS=2
PDF_RENDER_COMMAND=pdftoppm
PDF_EMBEDDING_PROVIDER=none
PDF_EMBEDDING_ENDPOINT=http://127.0.0.1:11434/v1/embeddings
PDF_EMBEDDING_API_KEY=
PDF_EMBEDDING_MODEL=nomic-embed-text
PDF_POSTGRES_CONNECTION_STRING=
PDF_QDRANT_URL=http://127.0.0.1:6333
PDF_QDRANT_API_KEY=
